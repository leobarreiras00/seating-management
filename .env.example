# Seatly - environment reference
# Copy the values you need into the place indicated for each component.
# NEVER commit real secrets. Real values live in Render, Vercel and local.properties.

# ---------------------------------------------------------------
# Backend (ASP.NET Core API) - set as environment variables on Render,
# or with `dotnet user-secrets` when running locally.
# The double underscore maps to the ":" separator in appsettings.json.
# ---------------------------------------------------------------
ConnectionStrings__DefaultConnection=Host=<neon-host>;Database=<db>;Username=<user>;Password=<password>;SSL Mode=Require
Jwt__Key=<random-string-of-at-least-32-characters>
Jwt__Issuer=SeatingManagementAPI
Jwt__Audience=SeatingManagementApp
EmailSettings__SenderName=Seatly Admin
EmailSettings__SenderEmail=<verified-sender@your-domain>
EmailSettings__BrevoApiKey=<brevo-api-key>

# ---------------------------------------------------------------
# Backoffice (Next.js) - set in backoffice/.env.local or in Vercel.
# NEXT_PUBLIC_* values are embedded in the browser bundle: treat them as public.
# ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://api-seatly.onrender.com
NEXT_PUBLIC_MQTT_URL=wss://<cluster>.s1.eu.hivemq.cloud:8884/mqtt
NEXT_PUBLIC_MQTT_USERNAME=<hivemq-username>
NEXT_PUBLIC_MQTT_PASSWORD=<hivemq-password>

# ---------------------------------------------------------------
# Android app - these go in frontend/SeatingManagementApp/local.properties
# (git-ignored), NOT in this file:
#   mqtt.username=<hivemq-username>
#   mqtt.password=<hivemq-password>
# If missing, the build falls back to "CHANGE_ME".
# ---------------------------------------------------------------
